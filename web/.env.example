NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_BASE_URL=
AI_API_KEY=
CLAUDE_MODEL=anthropic/claude-sonnet-5.5
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=
BOLNA_WEBHOOK_SECRET=
DISPATCH_SECRET=
APP_BASE_URL=
DEFAULT_CONCURRENCY=2
SEED_ACME_ADMIN_PASSWORD=
SEED_ACME_HM_PASSWORD=
SEED_OTHER_ADMIN_PASSWORD=
SEED_OWNER_EMAIL=
# Safety lock: phone calls are placed only when exactly "true".
DISPATCH_ENABLED=false
# Bolna source IPs allowed on the webhook + reschedule function (comma-separated).
# Empty = Bolna's published IPs (13.203.39.153,13.126.9.249,13.202.133.53). "off" disables the check.
BOLNA_IP_ALLOWLIST=
# INR per USD for the derived rupee figure next to call cost (Bolna bills in USD cents). Default 88.
COST_FX_INR_PER_USD=88
# Salt for hashing apply-form IPs in the rate-limit table (falls back to the service key if empty).
RATE_LIMIT_SALT=
